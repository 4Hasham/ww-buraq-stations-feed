# FTP server holding the AWS station .dat files
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# set to "true" if the server requires FTPS (explicit TLS)
FTP_SECURE=false
# folder on the FTP server to watch
FTP_REMOTE_DIR=/AWS_Uthal_Lasbella

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=aws
# collection where parsed readings are appended
MONGODB_DATA_COLLECTION=aws_station_readings
# collection used internally to remember each file's last-seen size/modified time
MONGODB_STATE_COLLECTION=aws_ftp_sync_state

# cron expression for the poll interval (default: every 10 minutes)
POLL_CRON=*/10 * * * *

# port for the lightweight health-check HTTP server (Railway sets this automatically)
PORT=3000

# UTC offset of the datalogger's local clock (timestamps in .dat files have no
# timezone of their own). Pakistan Standard Time has no DST, so this is fixed.
STATION_UTC_OFFSET=+05:00
