# FTP server holding the AWS station .dat files
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# set to "true" if the server requires FTPS (explicit TLS)
FTP_SECURE=false
# Stations to poll, as a comma-separated list of "id:remoteDir" pairs.
# The id tags every ingested row (_station) and looks up a fallback field
# schema (see src/config.js) for stations whose .dat exports have no header.
# e.g. FTP_REMOTE_DIRS=AWS_Uthal_Lasbella:/AWS_Uthal_Lasbella,AWS_Khairpur:/AWS_Khairpur
FTP_REMOTE_DIRS=AWS_Uthal_Lasbella:/AWS_Uthal_Lasbella
# legacy fallback if FTP_REMOTE_DIRS is not set (single station only)
FTP_REMOTE_DIR=/AWS_Uthal_Lasbella

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=aws
# Readings are split one collection per table (e.g. "<prefix>_hourly",
# "<prefix>_decmin"), created automatically as new tables are seen.
MONGODB_DATA_COLLECTION_PREFIX=aws_station_readings
# collection used internally to remember each file's last-seen size/modified time
MONGODB_STATE_COLLECTION=aws_ftp_sync_state

# cron expression for the poll interval (default: every 10 minutes)
POLL_CRON=*/10 * * * *

# port for the HTTP server (health check + /readings API); Railway sets this automatically
PORT=3000

# UTC offset of the datalogger's local clock (timestamps in .dat files have no
# timezone of their own). Pakistan Standard Time has no DST, so this is fixed.
STATION_UTC_OFFSET=+05:00
